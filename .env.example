# Copy to .env for local development. Replace all local sample credentials before sharing a network deployment.
DATABASE_URL=jdbc:postgresql://localhost:5432/flashstock
DATABASE_USERNAME=flashstock
DATABASE_PASSWORD=change-me-local-only
DB_POOL_SIZE=32
DB_CONNECTION_TIMEOUT_MS=3000
INVENTORY_RESERVATION_STRATEGY=conditional
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT=1s
REDIS_COMMAND_TIMEOUT=1s
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=flashstock
RABBITMQ_PASSWORD=change-me-local-only
RABBITMQ_CONNECTION_TIMEOUT=2s
DEV_USER=demo
DEV_PASSWORD=change-me-local-only
RESERVATION_TTL=PT10M
EXPIRATION_BATCH_SIZE=100
MESSAGING_ENABLED=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local-only
