{
  "id": null,
  "uid": "flashstock-overview",
  "title": "FlashStock Overview",
  "tags": ["flashstock", "inventory"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {"id": 1, "type": "timeseries", "title": "HTTP request rate", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}, "targets": [{"expr": "sum(rate(http_server_requests_seconds_count[1m])) by (uri, status)", "refId": "A"}]},
    {"id": 2, "type": "timeseries", "title": "Reservation outcomes", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}, "targets": [{"expr": "sum(rate(flashstock_reservations_total[1m])) by (outcome)", "refId": "A"}]},
    {"id": 3, "type": "timeseries", "title": "Outbox pending events", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}, "targets": [{"expr": "flashstock_outbox_backlog", "refId": "A"}]},
    {"id": 4, "type": "timeseries", "title": "RabbitMQ publish outcomes", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}, "targets": [{"expr": "sum(rate(flashstock_outbox_publish_total[1m])) by (outcome)", "refId": "A"}]},
    {"id": 5, "type": "timeseries", "title": "Database pool", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}, "targets": [{"expr": "hikaricp_connections_active", "refId": "A"}, {"expr": "hikaricp_connections_pending", "refId": "B"}]},
    {"id": 6, "type": "timeseries", "title": "Reservation API p95", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}, "targets": [{"expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{uri=~\"/api/v1/reservations.*\"}[5m])) by (le))", "refId": "A"}]}
  ]
}
